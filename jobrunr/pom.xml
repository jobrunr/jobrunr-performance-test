<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jobrunr.performance</groupId>
        <artifactId>performance-test</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jobrunr</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jobrunr.version>1.0.0-SNAPSHOT</jobrunr.version>
    </properties>

    <repositories>
        <repository>
            <id>JobRunrPro</id>
            <url>https://repo.jobrunr.io/private-releases/</url>
        </repository>
    </repositories>

    <profiles>
        <profile>
            <id>OSS</id>
            <dependencies>
                <dependency>
                    <groupId>org.jobrunr</groupId>
                    <artifactId>jobrunr</artifactId>
                    <version>${jobrunr.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.jobrunr</groupId>
                    <artifactId>jobrunr</artifactId>
                    <version>${jobrunr.version}</version>
                    <classifier>test-fixtures</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>PRO</id>
            <dependencies>
                <dependency>
                    <groupId>org.jobrunr</groupId>
                    <artifactId>jobrunr-pro</artifactId>
                    <version>${jobrunr.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.jobrunr</groupId>
                    <artifactId>jobrunr-pro</artifactId>
                    <version>${jobrunr.version}</version>
                    <classifier>test-fixtures</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.jobrunr.performance</groupId>
            <artifactId>common</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jobrunr</groupId>
            <artifactId>jobrunr-pro</artifactId>
            <version>${jobrunr.version}</version>
            <scope>provided</scope> <!-- will be provided by profile -->
        </dependency>
        <dependency>
            <groupId>org.jobrunr</groupId>
            <artifactId>jobrunr-pro</artifactId>
            <version>${jobrunr.version}</version>
            <classifier>test-fixtures</classifier>
            <scope>provided</scope> <!-- will be provided by profile -->
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.20.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>