#!/bin/bash
set -euxo pipefail

shutdown -h +${ttl_minutes}

dnf install -y docker
systemctl enable --now docker

# Postgres data directory on the local NVMe instance store (enforced by a precondition on db_instance_type)
INSTANCE_STORE=$(lsblk -dpno NAME,MODEL | grep -i 'Instance Storage' | head -1 | awk '{print $1}')
mkfs.xfs -f "$INSTANCE_STORE"
mkdir -p /mnt/instance-store
mount -o noatime "$INSTANCE_STORE" /mnt/instance-store
mkdir -p /mnt/instance-store/pgdata

docker run -d --name postgres --restart unless-stopped --network host --shm-size=2g \
  -v /mnt/instance-store/pgdata:/var/lib/postgresql \
  -e POSTGRES_DB=jobrunr_perf \
  -e POSTGRES_USER=jobrunr \
  -e POSTGRES_PASSWORD=${db_password} \
  postgres:18.6 postgres %{ for setting in postgres_settings ~} -c ${setting} %{ endfor }
